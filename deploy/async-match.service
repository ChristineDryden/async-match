[Unit]
Description=Valhalla basketball standings
After=network.target mysql.service

[Service]
Type=simple
WorkingDirectory=/opt/async-match
Environment=HOST=0.0.0.0
Environment=PORT=8765
EnvironmentFile=/etc/async-match.env
ExecStart=/opt/async-match/.venv/bin/gunicorn --bind 0.0.0.0:8765 --workers 1 --timeout 180 server.app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
